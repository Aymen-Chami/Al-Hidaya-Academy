# Copy to `.env` (cp .env.example .env) and adjust. Read by docker compose and by the API.

# --- Postgres (used to build DATABASE_URL inside compose) ---
POSTGRES_DB=alhidaya
POSTGRES_USER=alhidaya
# If it contains URL-special characters (@ : / % ...), URL-encode them.
POSTGRES_PASSWORD=alhidaya-dev

# --- API ---
# development | production   (production enforces a strong SECRET_KEY and COOKIE_SECURE=true)
ENV=development
LOG_LEVEL=INFO
# HMAC pepper for one-time email codes. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-insecure-secret-key-change-me
# Public URL of the web app (used in email links).
APP_BASE_URL=http://localhost:5173
# Origins allowed to make state-changing requests (comma-separated). Same-origin requests are always allowed.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000,http://localhost:8080
# Must be true when served over HTTPS (production).
COOKIE_SECURE=false

# --- Email ---
# smtp | console | memory
EMAIL_BACKEND=smtp
EMAIL_FROM=Al Hidayah Academy <no-reply@alhidayah.local>
# Dev default: Mailpit, which captures mail at http://localhost:8025 and delivers nothing.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false
SMTP_USE_TLS=false

# --- Real delivery ---
# A) Gmail account (quick; ~500 recipients/day; good for testing).
#    Needs 2-Step Verification on the account, then an App Password:
#    https://myaccount.google.com/apppasswords  -> 16 characters, spaces don't matter.
#    Gmail rewrites the From header to the authenticated account, so EMAIL_FROM must use it.
# EMAIL_FROM=Al Hidayah Academy <your-gmail@gmail.com>
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-gmail@gmail.com
# SMTP_PASSWORD=your-16-char-app-password
# SMTP_STARTTLS=true
# SMTP_USE_TLS=false
#
# B) Transactional provider (better deliverability and volume for production).
#    SendGrid: smtp.sendgrid.net:587, username "apikey", password = the API key.
#    Postmark / SES / Resend are the same shape. Set SPF and DKIM on the sending domain.

# --- Host ports (dev) ---
# DB_HOST_PORT=55432
# API_HOST_PORT=8000
# WEB_PORT=8080
