# Copy to `.env` (cp .env.example .env) and adjust. Read by docker compose and by the API.

# --- Postgres (used to build DATABASE_URL inside compose) ---
POSTGRES_DB=alhidaya
POSTGRES_USER=alhidaya
# If it contains URL-special characters (@ : / % ...), URL-encode them.
POSTGRES_PASSWORD=alhidaya-dev

# --- API ---
# development | production   (production enforces a strong SECRET_KEY and COOKIE_SECURE=true)
ENV=development
LOG_LEVEL=INFO
# HMAC pepper for one-time email codes. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-insecure-secret-key-change-me
# Public URL of the web app (used in email links).
APP_BASE_URL=http://localhost:5173
# Origins allowed to make state-changing requests (comma-separated). Same-origin requests are always allowed.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000,http://localhost:8080
# Must be true when served over HTTPS (production).
COOKIE_SECURE=false

# --- Email ---
# smtp | console | memory
EMAIL_BACKEND=smtp
EMAIL_FROM=Al Hidayah Academy <no-reply@alhidayah.local>
# Dev: Mailpit (set automatically by docker-compose.override.yml). Prod: your provider's SMTP relay
# (SendGrid: smtp.sendgrid.net:587 + SMTP_STARTTLS=true, user "apikey"; Postmark/SES similar).
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false
SMTP_USE_TLS=false

# --- Host ports (dev) ---
# DB_HOST_PORT=55432
# API_HOST_PORT=8000
# WEB_PORT=8080
