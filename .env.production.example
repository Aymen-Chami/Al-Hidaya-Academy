# Production environment for Al Hidayah Academy.
#
#   cp .env.production.example .env      (on the server — never commit the filled-in .env)
#
# Generate the two secrets with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"    # SECRET_KEY
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"    # POSTGRES_PASSWORD

# --- Postgres ---
POSTGRES_DB=alhidaya
POSTGRES_USER=alhidaya
# URL-encode any of @ : / % # ? that appear in it, or pick a password without them.
POSTGRES_PASSWORD=CHANGE-ME

# --- API ---
# `production` refuses to start with a weak SECRET_KEY or a non-Secure cookie. That guard is
# deliberate: keep it, and serve over HTTPS.
ENV=production
LOG_LEVEL=INFO
SECRET_KEY=CHANGE-ME-32-CHARS-OR-MORE
# Your real site, used in email links and for the cross-site request check.
APP_BASE_URL=https://signup.your-domain.org
ALLOWED_ORIGINS=https://signup.your-domain.org
COOKIE_SECURE=true

# --- HTTPS (docker-compose.tls.yml) ---
# Set once DNS points at this server. Leave empty to serve plain HTTP while you wait for a domain
# (in which case ENV must stay `development` and COOKIE_SECURE `false` — browsers drop Secure
# cookies on http://, so nobody could log in).
PUBLIC_DOMAIN=signup.your-domain.org
# Optional: to get Let's Encrypt renewal-failure warnings, uncomment the `email` line in
# caddy/Caddyfile. Caddy renews automatically either way.

# --- Email ---
EMAIL_BACKEND=smtp
# A transactional provider is the right answer for a school: a plain Gmail account is capped at
# roughly 500 recipients a day and its mail is more likely to land in spam.
#   SendGrid : smtp.sendgrid.net:587, SMTP_USERNAME=apikey, SMTP_PASSWORD=<api key>
#   Postmark : smtp.postmarkapp.com:587
# Set SPF and DKIM records for the sending domain, or approvals will go to junk.
EMAIL_FROM=Al Hidayah Academy <no-reply@your-domain.org>
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USERNAME=apikey
SMTP_PASSWORD=CHANGE-ME
SMTP_STARTTLS=true
SMTP_USE_TLS=false
